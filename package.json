{
  "name": "@kidthales/pgmmv-collision-plugin",
  "version": "0.2.0",
  "description": "Utilities for working with PGMMV object collisions.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "concurrently --group --names eslint,prettier,tsc \"eslint --cache .\" \"prettier --check \\\"**/*.{html,css,scss,md,json,yaml,yml}\\\"\" \"tsc --noEmit\"",
    "lint-fix": "concurrently --group --names eslint,prettier \"eslint --cache --fix .\" \"prettier --write \\\"**/*.{html,css,scss,md,json,yaml,yml}\\\"\"",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kidthales/pgmmv-types": "^0.2.1",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
